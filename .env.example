# 실행 환경: local | dev | prod
NODE_ENV=local

# 서버 포트
PORT=3000

# DB 접속 정보 (로컬은 docker-compose 기준)
# 접속 문자열 대신 쪼개서 쓰는 이유는 src/config/env.ts 주석 참고
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flyer_g
DB_SSL=false

# Infoteam IdP (OAuth 2.0 / OIDC). 클라이언트는 IdP 콘솔에서 발급받는다.
IDP_URL=https://api.account.gistory.me
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=

# 자체 access token(JWT) 서명 키(32자 이상)와 만료 시간(초)
# 생성 예: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=3600
