# 실행 환경: local | dev | prod
NODE_ENV=local

# 서버 포트
PORT=3000

# DB 접속 정보 (로컬은 docker-compose 기준)
# 접속 문자열 대신 쪼개서 쓰는 이유는 src/config/env.ts 주석 참고
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flyer_g
DB_SSL=false

# Infoteam IdP (OAuth 2.0 / OIDC). 클라이언트는 IdP 콘솔에서 발급받는다.
IDP_URL=https://api.account.gistory.me
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=

# 자체 access token(JWT) 서명 키(32자 이상)와 만료 시간(초)
# 생성 예: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=3600

# 포스터 저장소 (AWS S3). 버킷·IAM 키는 icarus-infra의 image_s3 모듈이 만든다.
# 로컬 개발은 staging 버킷과 그 키를 쓴다 (staging 버킷 CORS에 localhost:5173이 있다).
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=gsainfoteam-icarus-flyer-g-staging
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Swagger 문서(/docs, /docs-json) Basic Auth 잠금.
# 둘 다 설정하면 잠기고, 둘 다 비우면 공개된다. 하나만 설정하면 서버가 시작되지 않는다.
# dev/prod 배포 환경에서는 반드시 설정한다.
SWAGGER_USER=
SWAGGER_PASSWORD=
